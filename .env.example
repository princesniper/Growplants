# ============================================================================
# GrowPlants — Server-Side Environment Variables
# Source: 04_environment_and_configs.md §1
# Copy this file to ".env" and fill in real values. NEVER commit .env.
# ============================================================================

# PostgreSQL database URL (Neon, RDS, or local Postgres)
# Phase 1 sandbox uses SQLite — set to "file:./dev.db" until PostgreSQL is provisioned.
DATABASE_URL="file:./dev.db"

# JWT secrets for HTTP-only session cookies
JWT_SECRET="growplants-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="growplants-super-secret-refresh-jwt-key-change-in-production"

# Public app URL (used for SEO, OG tags, sitemap)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================================
# Firebase (SEC-006, owner-approved 2026-10-29) — production project is
# my-login-demo-88fb2 for BOTH repos. The Web API key is NOT a secret (client
# identifier) but must be restricted via Google Cloud API restrictions.
# FIREBASE_ADMIN_* service-account credentials go to the ADMIN repo's
# untracked service-account JSON only — never here, never committed.
# ============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="my-login-demo-88fb2.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="my-login-demo-88fb2"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="my-login-demo-88fb2.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Node environment
NODE_ENV="development"

# Razorpay (Phase 10 — Checkout)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# SMS (Phase 5+ — OTP, notifications)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="GRWPLT"

# Email (Phase 5+ — registration, invoices, booking confirmations)
SENDGRID_API_KEY=""

# Maps (Phase 7+ — pincode picker, address map)
GOOGLE_MAPS_API_KEY=""

# Storage (optional — Firebase Storage is the default)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET="growplants-media"
AWS_REGION="ap-south-1"
