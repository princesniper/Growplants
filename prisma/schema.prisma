// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  addresses Address[]
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// ORDERS — Dual-DB Strategy (PostgreSQL/SQLite via Prisma + Firestore)
// ============================================================================

/// Top-level order record. Mirrored to Firestore orders/{orderId} for real-time.
model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique                 // GP-YYYYMMDD-XXXX (sequential per day)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressId     String?
  address       Address? @relation(fields: [addressId], references: [id])

  // Totals (in paise/int to avoid float drift)
  subtotal      Int      @default(0)
  shippingFee   Int      @default(0)
  discount      Int      @default(0)
  tax           Int      @default(0)
  totalAmount   Int      @default(0)

  // Payment
  paymentMethod String   @default("cod")          // "cod" | "razorpay"
  paymentStatus String   @default("pending")      // pending|paid|failed|refunded|partial_refund

  // Order status (7-step flow + cancelled)
  status        String   @default("pending")      // pending|confirmed|processing|packed|shipped|out_for_delivery|delivered|cancelled

  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// ============================================================================
/// ProductStock — SEC-003/004 (Option W): durable decrement authority for the
/// canonical website checkout.
///   - Baseline is seeded on first checkout from the static catalog's stock
///     value (src/data/*.json via @/lib/product-pricing). From then on this
///     row is the single stock authority; decrements happen with a
///     conditional `updateMany(stock >= qty)` inside the checkout
///     transaction, so concurrent orders cannot oversell and a failed
///     transaction leaves no partial decrement.
///   - Catalog products with `stock: null` are treated as UNLIMITED: no row
///     is created and no decrement occurs for them.
/// ============================================================================
model ProductStock {
  productId String   @id // catalog slug, e.g. "poinsettia-pink-plant"
  stock     Int // absolute remaining units (never negative by construction)
  updatedAt DateTime @updatedAt
}

/// CheckoutIdempotency — SEC-004: persistent duplicate-payment/ordering guard.
/// The client supplies an `Idempotency-Key` header per checkout submission.
/// `fingerprint` is a server-computed sha256 of the request's identity +
/// validated inputs; reusing a key with an EQUIVALENT payload replays the
/// original order result, a CONFLICTING payload gets 409. The row is created
/// inside the same Prisma transaction as the order, so reservation and order
/// commit (and rollback) are atomic — no orphan reservations.
model CheckoutIdempotency {
  key         String   @id
  userId      String
  fingerprint String
  orderId     String // set to the created order's id when the tx commits
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([orderId])
}

/// Line items for an order. productSnapshot keeps the product JSON at order time.
model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId       String
  name            String
  slug            String
  image           String
  quantity        Int      @default(1)
  unitPrice       Int
  totalPrice      Int
  /// JSON string snapshot of product at order time
  productSnapshot String   @default("{}")

  createdAt       DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

/// Audit log of every status change.
model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status      String                                   // OrderStatus value
  remarks     String?
  createdBy   String   @default("system")              // uid or "system" | "admin"
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

/// Saved addresses (per user). One address can be used by multiple orders.
model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName        String
  phone           String
  addressLine1    String
  addressLine2    String?
  landmark        String?
  city            String
  state           String
  pincode         String
  latitude        Float?
  longitude       Float?

  // Location verification — mandatory for all new addresses
  locationVerified Boolean  @default(false)    // true only after user confirms location (GPS or map)
  locationSource    String?                     // "gps" | "manual"
  locationAccuracy  Float?                      // GPS accuracy in meters (null if manual)

  isDefault       Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders          Order[]

  @@index([userId])
}
